<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the FileProvider may share. The v1.13 files-search walk only ever hands
     out files from the shared external storage, so that is all that is listed.
     v1.18.0 adds the cache folder where "Share app" stages APK copies. -->
<paths>
    <external-path name="external" path="." />
    <external-files-path name="external_files" path="." />
    <cache-path name="shared_apks" path="shared_apks/" />
</paths>
